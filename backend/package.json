{
  "name": "@msimulation-xml/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test": "bash run-tests.sh",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.4",
    "@getbrevo/brevo": "^5.0.4",
    "@msimulation-xml/fiscal-core": "workspace:*",
    "@msimulation-xml/nfe-xml": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.11.3",
    "fastify-plugin": "^5.0.1",
    "otplib": "^13.4.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "^7.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  }
}
