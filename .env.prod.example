# =============================================================================
# MSimulation-XML — variáveis de produção (docker-compose.prod.yml)
# =============================================================================
#
# Uso:
#   cp .env.prod.example .env.prod
#   docker login ghcr.io -u <usuario-github>   # uma vez (ver docs/deploy-docker-aws.md)
#   docker compose --env-file .env.prod -f docker-compose.prod.yml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --remove-orphans
#
# Segredos de aplicação (JWT_SECRET, DATABASE_URL, BREVO_API_KEY, etc.) continuam
# em backend/.env e frontend/.env.local. As imagens vêm prontas do ghcr.io
# (publicadas por .github/workflows/docker-publish.yml); não há build local.
#
# TLS/domínio: não é feito aqui. O proxy compartilhado da infra já cuida de
# HTTPS e do roteamento por domínio → porta fixa (ver docker-compose.prod.yml).
# =============================================================================

# --- Portas fixas esperadas pelo proxy compartilhado da infra -----------------
# app.msimulation-xml.nerus.com.br → 5000 (frontend) | api. → 5001 (backend)
# Não são loopback-only: o proxy da infra precisa alcançá-las.

BACKEND_PORT=5001
FRONTEND_PORT=5000

# --- Versão das imagens (ghcr.io) ----------------------------------------------
# "latest" segue sempre o último push em main. Para fixar/reverter uma versão,
# use o sha do commit publicado (ex.: a1b2c3d...), igual nos dois serviços.

IMAGE_TAG=latest
