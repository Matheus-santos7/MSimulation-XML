# =============================================================================
# MSimulation-XML — variáveis de produção (docker-compose.prod.yml)
# =============================================================================
#
# Uso:
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Segredos de aplicação (JWT_SECRET, DATABASE_URL, BREVO_API_KEY, etc.) continuam
# em backend/.env e frontend/.env.local — este arquivo cobre só o que o compose
# e o Caddy (TLS/roteamento) precisam.
# =============================================================================

# --- DNS / TLS (Caddy) ---------------------------------------------------------
# Registre estes hosts no Route53 (registro A) apontando para o IP do servidor.

API_DOMAIN=api.seudominio.com
APP_DOMAIN=app.seudominio.com

# E-mail usado pelo Caddy para o registro ACME (Let's Encrypt) e avisos de expiração.
ACME_EMAIL=seu-email@seudominio.com

# --- Portas locais (debug/SSH tunnel — não expostas publicamente) -------------
# O tráfego público chega sempre pelo Caddy (80/443). Estas portas ficam em
# 127.0.0.1 no host, úteis para testar cada serviço direto via túnel SSH.

BACKEND_PORT=3001
FRONTEND_PORT=3000

# --- PostgreSQL (container) ----------------------------------------------------
# Use estes mesmos valores na DATABASE_URL de backend/.env, trocando o host
# para "postgres" (nome do serviço na rede interna do compose), ex.:
# DATABASE_URL=postgresql://msimulation:msimulation@postgres:5432/msimulation_xml?schema=public

POSTGRES_USER=msimulation
POSTGRES_PASSWORD=msimulation
POSTGRES_DB=msimulation_xml

# --- Build-time do frontend (NEXT_PUBLIC_* é embutido no bundle do client) ----

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
